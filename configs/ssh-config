# Servers ==================================================================================================

Host tilde.town
    User strawmelonjuice
    IdentityFile ~/.ssh/id_ed25519_sk_rk_ssh_strawmelonjuice_main

# ---- Cubchoo
Host strawmelonservices
    HostName cubchoo.taild5b3d4.ts.net
        User root
        Port 22
        IdentityFile ~/.ssh/id_ed25519_sk_rk_ssh_strawmelonjuice_main
Host strawmelonservices-temp
    RequestTTY yes
    RemoteCommand watch -n 1 "vcgencmd measure_temp && cat /sys/class/thermal/cooling_device0/cur_state"
    HostName cubchoo.taild5b3d4.ts.net
        User root
        Port 22
        IdentityFile ~/.ssh/id_ed25519_sk_rk_ssh_strawmelonjuice_main
