matrix.strawmelonjuice.com {
	reverse_proxy /_matrix/* matrix:8008
	reverse_proxy /_synapse/client/* matrix:8008
	reverse_proxy matrix:8008 {
		transport http {
			read_timeout 300s
			write_timeout 300s
		}
	}
