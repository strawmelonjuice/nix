matrix.strawmelonjuice.com {
	# CORS headers for federation and clients
	header Access-Control-Allow-Origin *

	reverse_proxy /_matrix/*  matrix:8008 {
		transport http {
			read_timeout 300s
			write_timeout 300s
		}
	}
	reverse_proxy /_synapse/client/*  matrix:8008 {
		transport http {
			read_timeout 300s
			write_timeout 300s
		}
	}
	

	# Redirect root visits to Cinny web client
	redir / https://app.cinny.in/#/login?homeserver=https://strawmelonjuice.com 302
}
